# Copy to .env.postgresql and use alongside the existing .env.production.
# Never commit either real environment file. Use separate generated passwords.
POSTGRES_DB=limituplab
POSTGRES_USER=limituplab_admin
POSTGRES_PASSWORD=
# POSTGRES_* belongs to the bootstrap administrator, used only for provisioning.
# Create the NOSUPERUSER application role as described in deploy/postgresql.md.
# Use its different password below; percent-encode URL-reserved characters.
LIMITUPLAB_DATABASE_URL=postgresql+psycopg://limituplab:REPLACE_WITH_APP_PASSWORD@postgres:5432/limituplab
LIMITUPLAB_DB_POOL_SIZE=5
LIMITUPLAB_DB_MAX_OVERFLOW=5
INSTALL_HITHINK_FINANCE=true
APP_HTTP_PORT=8080
