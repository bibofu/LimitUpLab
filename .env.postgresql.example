# Copy to .env.postgresql and use alongside the existing .env.production.
# Never commit either real environment file. Use a unique generated password.
POSTGRES_DB=limituplab
POSTGRES_USER=limituplab
POSTGRES_PASSWORD=
# Use the same password above; percent-encode URL-reserved password characters.
LIMITUPLAB_DATABASE_URL=postgresql+psycopg://limituplab:REPLACE_WITH_PASSWORD@postgres:5432/limituplab
LIMITUPLAB_DB_POOL_SIZE=5
LIMITUPLAB_DB_MAX_OVERFLOW=5
INSTALL_HITHINK_FINANCE=true
APP_HTTP_PORT=8080
