# Merge these settings into backend/.env; never commit credentials or the cluster.
# The database must already contain the current Alembic schema and imported data.
LIMITUPLAB_DATABASE_URL=postgresql+psycopg://limituplab:REPLACE_WITH_PASSWORD@127.0.0.1:55433/limituplab
# Relative paths resolve from the repository root, regardless of the launch directory.
LIMITUPLAB_LOCAL_PG_BIN=.local/postgresql/pgsql/bin
LIMITUPLAB_LOCAL_PG_DATA=.local/postgresql/data
LIMITUPLAB_DB_POOL_SIZE=5
LIMITUPLAB_DB_MAX_OVERFLOW=5
