# Copy this file to backend/.env for local development.
# Never commit real API keys.

# Local development uses an internal signing key when this is blank. Production
# must set LIMITUPLAB_ENVIRONMENT=production and a random 32-byte-or-longer key.
LIMITUPLAB_SESSION_SECRET=

# Optional locally. When omitted, internal/admin APIs return 503. Production
# requires a separate random value of at least 32 bytes.
LIMITUPLAB_ADMIN_KEY=

# LLM
# V1 exposes completed-close and historical review tools only. Use `extended`
# solely for V2 development of live popularity, sector and public-web tools.
LIMITUPLAB_AGENT_PROFILE=v1_close_review
# deterministic: pattern guard only (default); llm: semantic review.
LIMITUPLAB_AGENT_COMPLIANCE=deterministic
# off | candidate | safe_auto_shadow | safe_auto. safe_auto only activates structured tool_display, closed typed and tool/entity/condition-scoped typed ADD candidates; safe_auto_judge and safe_auto_judge_shadow are optional.
LIMITUPLAB_MEMORY_AUTO_LEARN=safe_auto
# Unreviewed non-auto candidates expire after this many days.
LIMITUPLAB_MEMORY_CANDIDATE_TTL_DAYS=30
# Local BGE embeddings require fastembed and a downloaded model.
LIMITUPLAB_MEMORY_EMBEDDINGS=on
LIMITUPLAB_MEMORY_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# Estimated-token budget for one model input, including tool schemas and system
# rules. Keep input budget + answer tokens below the configured model window.
LIMITUPLAB_AGENT_INPUT_TOKEN_BUDGET=40000
LIMITUPLAB_LLM_ENABLED=true
# Production configuration accepts only LangChain conversational tool calling.
# Legacy text-only providers must be constructed explicitly by their consumers.
LIMITUPLAB_LLM_BACKEND=langchain
LIMITUPLAB_LLM_BASE_URL=https://api.deepseek.com
LIMITUPLAB_LLM_MODEL=deepseek-v4-flash
LIMITUPLAB_LLM_TIMEOUT_SECONDS=30
LIMITUPLAB_LLM_PLANNER_MAX_TOKENS=320
LIMITUPLAB_LLM_NATIVE_FUNCTION_CALLING=true
LIMITUPLAB_LLM_MAX_ATTEMPTS=2
# Keep fast tool planning and grounded answers in non-thinking mode.
LIMITUPLAB_LLM_THINKING_ENABLED=false
DEEPSEEK_API_KEY=

# Optional LLM tracing (Langfuse). Off by default and fail-open: missing
# credentials, a bad host or an unreachable collector must never affect chat.
LIMITUPLAB_LANGFUSE_ENABLED=false
LIMITUPLAB_LANGFUSE_SAMPLE_RATE=1.0
LIMITUPLAB_LANGFUSE_ENVIRONMENT=local
# Credentials belong in backend/.env (gitignored), never in this file.
# LANGFUSE_HOST=https://us.cloud.langfuse.com
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# Public Agent rate limits and cost accounting. Token cost remains 0 until the
# current provider's per-million-token prices are explicitly configured.
LIMITUPLAB_AGENT_RATE_LIMIT_ENABLED=true
LIMITUPLAB_AGENT_REQUESTS_PER_MINUTE=8
LIMITUPLAB_AGENT_REQUESTS_PER_DAY=60
LIMITUPLAB_AGENT_IP_REQUESTS_PER_MINUTE=20
LIMITUPLAB_AGENT_MAX_CONCURRENT_PER_USER=1
LIMITUPLAB_AGENT_MAX_CONCURRENT_GLOBAL=4
LIMITUPLAB_AGENT_DAILY_COST_BUDGET_USD=0
LIMITUPLAB_LLM_INPUT_COST_PER_MILLION=0
LIMITUPLAB_LLM_OUTPUT_COST_PER_MILLION=0
LIMITUPLAB_TRUST_PROXY_HEADERS=false

# Comma-separated browser origins. Production normally uses the same origin via
# Nginx, but list the public domain explicitly when direct API access is needed.
LIMITUPLAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional local proxy. Leave empty if your network can reach the provider directly.
# Example: http://127.0.0.1:17891
LIMITUPLAB_PROXY_URL=

# Optional official Tonghuashun CLI integration. Authentication is stored by
# `hithink-finance auth login`; never put that API key in this project file.
# LIMITUPLAB_HITHINK_FINANCE_CLI=C:\Users\you\AppData\Roaming\npm\hithink-finance.cmd
LIMITUPLAB_HITHINK_TIMEOUT_SECONDS=15
# Shared PostgreSQL pacing between CLI starts; API and workers use the same gate.
LIMITUPLAB_HITHINK_MIN_INTERVAL_SECONDS=1
LIMITUPLAB_AKSHARE_POOL_TIMEOUT_SECONDS=60
LIMITUPLAB_AKSHARE_KLINE_TIMEOUT_SECONDS=60
# stock_profile runs CNInfo and Eastmoney in isolated workers. The deadline
# includes interpreter startup and provider work; failures become explicit gaps.
LIMITUPLAB_STOCK_PROFILE_CNINFO_TIMEOUT_SECONDS=12
LIMITUPLAB_STOCK_PROFILE_MARKET_CAP_TIMEOUT_SECONDS=8
LIMITUPLAB_STOCK_PROFILE_TENCENT_TIMEOUT_SECONDS=6
LIMITUPLAB_RECOMMENDATION_REFRESH_MINUTES=30

# PostgreSQL is required; create the database and run Alembic before startup.
# Local default is the Docker pgvector container; merge .env.docker-postgresql.example.
# The managed native cluster template at .env.local-postgresql.example is retained for rollback.
LIMITUPLAB_DATABASE_URL=postgresql+psycopg://limituplab:REPLACE@127.0.0.1:55434/limituplab
LIMITUPLAB_DB_POOL_SIZE=5
LIMITUPLAB_DB_MAX_OVERFLOW=5
# Optional report/artifact directory; this does not select database storage.
# LIMITUPLAB_DATA_DIRECTORY=data

# Chat uses the lightweight LangGraph runner only.

# Optional release commit/tag for private run provenance (never a credential).
LIMITUPLAB_BUILD_REVISION=
