# Copy this file to backend/.env for local development.
# Never commit real API keys.

# Local development uses an internal signing key when this is blank. Production
# must set LIMITUPLAB_ENVIRONMENT=production and a random 32-byte-or-longer key.
LIMITUPLAB_SESSION_SECRET=

# Optional locally. When omitted, internal/admin APIs return 503. Production
# requires a separate random value of at least 32 bytes.
LIMITUPLAB_ADMIN_KEY=

# LLM
# V1 exposes completed-close and historical review tools only. Use `extended`
# solely for V2 development of live popularity, sector and public-web tools.
LIMITUPLAB_AGENT_PROFILE=v1_close_review
LIMITUPLAB_LLM_ENABLED=true
LIMITUPLAB_LLM_BASE_URL=https://api.deepseek.com
LIMITUPLAB_LLM_MODEL=deepseek-v4-flash
LIMITUPLAB_LLM_TIMEOUT_SECONDS=30
LIMITUPLAB_LLM_PLANNER_MAX_TOKENS=320
LIMITUPLAB_LLM_MAX_ATTEMPTS=2
LIMITUPLAB_LLM_RETRY_DELAY_SECONDS=0.5
# Keep fast tool planning and grounded answers in non-thinking mode.
LIMITUPLAB_LLM_THINKING_ENABLED=false
DEEPSEEK_API_KEY=

# Public Agent rate limits and cost accounting. Token cost remains 0 until the
# current provider's per-million-token prices are explicitly configured.
LIMITUPLAB_AGENT_RATE_LIMIT_ENABLED=true
LIMITUPLAB_AGENT_REQUESTS_PER_MINUTE=8
LIMITUPLAB_AGENT_REQUESTS_PER_DAY=60
LIMITUPLAB_AGENT_IP_REQUESTS_PER_MINUTE=20
LIMITUPLAB_AGENT_MAX_CONCURRENT_PER_USER=1
LIMITUPLAB_AGENT_MAX_CONCURRENT_GLOBAL=4
LIMITUPLAB_AGENT_DAILY_COST_BUDGET_USD=0
LIMITUPLAB_LLM_INPUT_COST_PER_MILLION=0
LIMITUPLAB_LLM_OUTPUT_COST_PER_MILLION=0
LIMITUPLAB_TRUST_PROXY_HEADERS=false

# Comma-separated browser origins. Production normally uses the same origin via
# Nginx, but list the public domain explicitly when direct API access is needed.
LIMITUPLAB_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional local proxy. Leave empty if your network can reach the provider directly.
# Example: http://127.0.0.1:17891
LIMITUPLAB_PROXY_URL=

# Optional extended-profile public-web search settings.
LIMITUPLAB_WEB_SEARCH_PROVIDER=auto
LIMITUPLAB_WEB_SEARCH_TIMEOUT_SECONDS=12

# Optional official Tonghuashun CLI integration. Authentication is stored by
# `hithink-finance auth login`; never put that API key in this project file.
# LIMITUPLAB_HITHINK_FINANCE_CLI=C:\Users\you\AppData\Roaming\npm\hithink-finance.cmd
LIMITUPLAB_HITHINK_TIMEOUT_SECONDS=15

# Optional SQLite path override.
# LIMITUPLAB_DATABASE_PATH=backend/data/limituplab.sqlite

# SQLite single-host concurrency hardening.
LIMITUPLAB_SQLITE_WAL_ENABLED=true
LIMITUPLAB_SQLITE_BUSY_TIMEOUT_MS=5000
LIMITUPLAB_SQLITE_LOCK_RETRY_ATTEMPTS=3
LIMITUPLAB_SQLITE_LOCK_RETRY_BASE_DELAY_SECONDS=0.05
LIMITUPLAB_SQLITE_WAL_AUTOCHECKPOINT_PAGES=1000
