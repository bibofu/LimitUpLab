# Docker Compose
APP_HTTP_PORT=8080
INSTALL_HITHINK_FINANCE=true
LIMITUPLAB_ENVIRONMENT=production

# Anonymous visitor identity. Generate a unique value with:
# openssl rand -hex 32
LIMITUPLAB_SESSION_SECRET=

# Internal/admin APIs use a separate key sent through
# X-LimitUpLab-Admin-Key. Generate another independent value.
LIMITUPLAB_ADMIN_KEY=

# Public origin allowed to call the API directly. Same-origin Nginx requests do
# not require CORS, but keeping the production domain explicit prevents mistakes.
LIMITUPLAB_CORS_ORIGINS=https://example.com,https://www.example.com

# LLM
# Keep production V1 on completed-close and historical review tools only.
LIMITUPLAB_AGENT_PROFILE=v1_close_review
# deterministic: pattern guard only (default); llm: semantic review.
LIMITUPLAB_AGENT_COMPLIANCE=deterministic
# off | candidate | safe_auto_shadow | safe_auto. safe_auto only activates structured tool_display ADD candidates.
LIMITUPLAB_MEMORY_AUTO_LEARN=safe_auto
LIMITUPLAB_LLM_ENABLED=true
LIMITUPLAB_LLM_BASE_URL=https://api.deepseek.com
LIMITUPLAB_LLM_MODEL=deepseek-v4-flash
LIMITUPLAB_LLM_TIMEOUT_SECONDS=30
LIMITUPLAB_LLM_PLANNER_MAX_TOKENS=320
LIMITUPLAB_LLM_MAX_ATTEMPTS=2
LIMITUPLAB_LLM_RETRY_DELAY_SECONDS=0.5
LIMITUPLAB_LLM_THINKING_ENABLED=false
DEEPSEEK_API_KEY=

# Public Agent capacity and daily anonymous visitor quota. Nginx is the only
# public entry point in docker-compose, so its forwarded client IP is trusted.
LIMITUPLAB_AGENT_RATE_LIMIT_ENABLED=true
LIMITUPLAB_AGENT_REQUESTS_PER_MINUTE=8
LIMITUPLAB_AGENT_REQUESTS_PER_DAY=60
LIMITUPLAB_AGENT_IP_REQUESTS_PER_MINUTE=20
LIMITUPLAB_AGENT_MAX_CONCURRENT_PER_USER=1
LIMITUPLAB_AGENT_MAX_CONCURRENT_GLOBAL=4
LIMITUPLAB_AGENT_DAILY_COST_BUDGET_USD=0
LIMITUPLAB_LLM_INPUT_COST_PER_MILLION=0
LIMITUPLAB_LLM_OUTPUT_COST_PER_MILLION=0
LIMITUPLAB_TRUST_PROXY_HEADERS=true

# Tonghuashun hithink-finance CLI. Keep the key only on the server.
HITHINK_FINANCE_API_KEY=
LIMITUPLAB_HITHINK_TIMEOUT_SECONDS=15
# Each AKShare limit-up/failed-pool call runs in a disposable process. Its
# deadline includes process startup, collection and result serialization.
LIMITUPLAB_AKSHARE_POOL_TIMEOUT_SECONDS=60
LIMITUPLAB_AKSHARE_KLINE_TIMEOUT_SECONDS=60
# stock_profile runs CNInfo and Eastmoney in isolated workers. The deadline
# includes interpreter startup and provider work; failures become explicit gaps.
LIMITUPLAB_STOCK_PROFILE_CNINFO_TIMEOUT_SECONDS=12
LIMITUPLAB_STOCK_PROFILE_MARKET_CAP_TIMEOUT_SECONDS=8
LIMITUPLAB_STOCK_PROFILE_TENCENT_TIMEOUT_SECONDS=6
# Dashboard provider batches run in isolated, terminable processes. These are
# whole-batch deadlines (including spawn), not a separate timeout per fallback.
LIMITUPLAB_MARKET_INDEX_TIMEOUT_SECONDS=30
LIMITUPLAB_TRADING_CALENDAR_TIMEOUT_SECONDS=30
# CLI sector snapshot batches only; catalog and optional industry supplements
# use their own provider timeouts. Individual CLI calls still use the limit above.
LIMITUPLAB_SECTOR_SNAPSHOT_TIMEOUT_SECONDS=60
# Refresh latest quotes and stock news every 30 minutes. Quarterly financials
# are reused for 24 hours to avoid repeating unchanged remote queries.
LIMITUPLAB_RECOMMENDATION_REFRESH_MINUTES=30

# Optional local networking
LIMITUPLAB_PROXY_URL=

# PostgreSQL is required. Configure its URL and credentials in .env.postgresql.
# Keep reports and archived migration inputs in this separate data directory.
LIMITUPLAB_DATA_DIRECTORY=/app/data
LIMITUPLAB_BUILD_REVISION=
